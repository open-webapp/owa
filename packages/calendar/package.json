{
  "name": "@open-webapp/calendar",
  "version": "0.5.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-webapp/owa",
    "directory": "packages/calendar"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && cp src/react/styles.css dist/styles.css",
