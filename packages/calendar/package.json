    "test:theme-browser": "vitest run --config vitest.browser.config.ts"
  },
  "peerDependencies": {
    "react": "^19",
    "vitest": "^2.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser": "2.1.9",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^30.0.1",
    "playwright": "1.51.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
